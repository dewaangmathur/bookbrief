# Rename this file to .env
# NOTE: OPENAI_API_KEY is no longer needed here. Each user enters their own
# OpenAI key in the browser (BookBrief UI) and it's sent per-request from
# there - this server never stores or reads a key from .env anymore.

# Model used for summarization
SUMMARY_MODEL=gpt-4o-mini

# Max tokens per chunk when a chapter is too long for one call
MAX_CHUNK_TOKENS=6000

# How many chapters to summarize in parallel (speeds things up a lot)
MAX_CHAPTER_WORKERS=4

# How many chunks within one long chapter to summarize in parallel
MAX_CHUNK_WORKERS=6

# Pricing per 1M tokens (USD) - used only for cost estimates in logs
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

PORT=5000
